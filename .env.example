# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) 또는 기존 anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 이메일 인증·초대 링크에 사용되는 사이트 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 카카오 Developers 앱 > 앱 키 > REST API 키 (주소 좌표·주변 장소 검색, 서버 전용)
# https://developers.kakao.com/docs/latest/ko/local/common
KAKAO_REST_API_KEY=
# 공공데이터포털 「전국공인중개사사무소표준데이터」 활용신청 후 발급받은 일반 인증키 (서버 전용, NEXT_PUBLIC_ 금지)
# https://www.data.go.kr/data/15107745/standard.do
DATA_GO_KR_SERVICE_KEY=
# 위 키로 「국세청_사업자등록정보 진위확인 및 상태조회 서비스」도 활용신청해야 사무소 인증이 동작한다
# https://www.data.go.kr/data/15081808/openapi.do
# 확인설명서 「건축HUB 채우기」는 같은 키로 「국토교통부_건축HUB_건축물대장정보」 활용신청이 필요하다
# https://www.data.go.kr/data/15134735/openapi.do
# 사무소 등록 RPC(register_office) 호출용 서버 전용 비밀값. DB(private.server_secrets)에는 sha256 해시만 저장
# 값을 바꾸면 새 해시로 마이그레이션을 추가해야 한다. 생성: openssl rand -hex 32
OFFICE_REGISTRATION_SECRET=
# CODEF API (서버 전용, NEXT_PUBLIC_ 금지) — https://codef.io
# OAuth: https://oauth.codef.io/oauth/token  /  API: https://api.codef.io (샌드박스: https://sandbox.codef.io, https://development.codef.io)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
# RSA 공개키 (CODEF 계정 키 페이지). 인터넷등기소 비회원 비밀번호 암호화에 사용
CODEF_PUBLIC_KEY=
# 인터넷등기소 비로그인 열람용 전화번호와 재열람 비밀번호(임의의 숫자 4자리)
CODEF_PHONE_NO=
CODEF_PASSWORD=
# 대법원 인터넷등기소 전자민원캐시 (등기 수수료 차감용 — 사이트 로그인 비번 아님)
CODEF_EPREPAY_NO=
CODEF_EPREPAY_PASS=
# true면 development.codef.io (데모), false면 api.codef.io (정식)
# 데모는 등기 요약(JSON)만 주고 PDF(resOriGinalData)가 빈 경우가 많음. PDF가 필요하면 false + 정식 키 사용
CODEF_USE_SANDBOX=true
# AI (서버 전용, NEXT_PUBLIC_ 금지) — 설정→AI·요금에서 고른 엔진에 맞는 키만 있으면 됨
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey (GEMINI_API_KEY 또는 GOOGLE_API_KEY)
GEMINI_API_KEY=
# 모델 교체가 필요할 때만 지정 (미지정 기본값: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
